# =====================================================================
# PontuaMax — Variáveis de Ambiente para Produção & Deploy (Whitelabel SaaS)
# =====================================================================

# 1. Supabase (Postgres, Auth e Storage)
SUPABASE_URL="https://sua-instancia.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"
VITE_SUPABASE_URL="https://sua-instancia.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"

# 2. Autenticação dos jobs agendados
# Gere um segredo aleatório forte e configure o mesmo valor no agendador.
CRON_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-bytes"

# 3. URL pública usada em links de portal e NPS enviados ao cliente
PUBLIC_APP_URL="https://seu-dominio.com.br"

# 4. Notificações WhatsApp (Evolution API Gateway)
EVOLUTION_API_URL="https://api.evolution.sua-empresa.com"
EVOLUTION_API_KEY="sua_chave_api_evolution"

# 5. Configuração de servidor
NODE_ENV="production"
PORT=3000
