# =====================================================================
# PontuaMax — Variáveis de Ambiente para Produção & Deploy (Whitelabel SaaS)
# =====================================================================

# 1. Supabase (Banco de Dados Postgres & Auth Multi-Tenant)
VITE_SUPABASE_URL="https://sua-instancia.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-admin"

# 2. Integração Olist / Tiny ERP (Webhooks Resilientes & Sync)
OLIST_WEBHOOK_SECRET="seu_secret_token_olist_aqui"

# 3. Notificações WhatsApp (Evolution API Gateway)
EVOLUTION_API_URL="https://api.evolution.sua-empresa.com"
EVOLUTION_API_KEY="sua_chave_api_evolution"

# 4. Configuração de Servidor & Node
NODE_ENV="production"
PORT=3000
